    {
      "type": "stat",
      "title": "Auto-executed",
      "description": "ALLOW_AUTO verdicts: repairs no human gated.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "kavach-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kavach-prometheus"
          },
          "expr": "sum(kavach_permit_verdicts_total{verdict=\"ALLOW_AUTO\"})",
