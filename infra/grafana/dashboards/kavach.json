    {
      "type": "stat",
      "title": "Escalated",
      "description": "Refused to act, or acted and unwound. Not a failure count.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "kavach-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kavach-prometheus"
          },
          "expr": "sum(kavach_incidents_total{status=\"ESCALATED\"})",
          "legendFormat": "escalated",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
