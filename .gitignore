# Secrets — never committed. AGENTS.md security rule 13.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Node / Next.js
node_modules/
.next/
out/
.pnpm-store/
*.tsbuildinfo
next-env.d.ts

# Local state
*.log
.DS_Store
Thumbs.db
Desktop.ini

# Generated API client (produced by `make gen-client`)
apps/console/lib/api/generated/

# Benchmark and report output
harness/reports/

# The sandbox's working copy of the target's prompts. Regenerated from
# production on every seed, and the directory a model-authored patch is
# tried in - so an experimental prompt must never be sweepable into a
# commit by `git add -A`.
infra/sandbox-prompts/

# Baseline captures are measurements of a particular moment, not source.
harness/baselines/

# Generated OpenAPI document (produced by `make gen-client`)
apps/console/lib/api/openapi.json
