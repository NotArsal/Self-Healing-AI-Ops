# Kavach — copy to .env and adjust. NEVER commit .env (AGENTS.md rule 13).
# Every key here is declared in apps/control-plane/kavach/config.py.

# --- Control-plane host ports -------------------------------------------------
# Every one of these is offset so Kavach and the target can run side by side,
# which P1 onward requires. The target publishes 8000 (backend), 3000
# (frontend), 5432 (db), 9090 (prometheus) and 11434 (ollama), and those are
# NOT ours to move — the target's frontend has http://localhost:8000 hardcoded
# in page.tsx and chat/page.tsx.
API_PORT=8080            # container still listens on 8000; only the host port moves
CONSOLE_PORT=3001
# `make dev-api` runs a SECOND copy of the same app with hot reload. It must
# not share API_PORT: Docker Desktop on Windows does not exclusively reserve a
# published port, so a local uvicorn binds 8080 alongside the container without
# error and silently shadows it for 127.0.0.1 traffic while `localhost` still
# resolves to the container. Two different builds, one port, no warning.
DEV_API_PORT=8081
POSTGRES_PORT=5433
PROMETHEUS_PORT=9091
# REDIS_PORT=6380   # returns in P3; Redis is not started in Phase 0
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317

# --- Control-plane Postgres ---------------------------------------------------
POSTGRES_USER=kavach
POSTGRES_PASSWORD=kavach
POSTGRES_DB=kavach

# --- Kavach's own RCA model ---------------------------------------------------
# Points DIRECTLY at Ollama, never through Toxiproxy, so injecting F01/F02 into
# the target cannot blind the diagnostician (PRD.md §6.3).
#
# One Ollama only (ARCHITECTURE.md §2.4). From inside a container, the host
# instance is host.docker.internal; from the host it is localhost.
#
# Model note: ARCHITECTURE.md §2.4 documents qwen2.5:7b-instruct as the default
# and permits llama3.2 "to reuse an already-resident model when memory is
# tight". llama3.2 is set here because this demo machine has 8GB of VRAM and
# already has llama3.2 pulled, so qwen2.5:7b would both need a 4.7GB download
# and contend with the target's own models.
KAVACH_LLM_BASE_URL=http://host.docker.internal:11434
KAVACH_LLM_MODEL=llama3.2

# --- Cloud model providers (OPTIONAL) -----------------------------------------
# Kavach runs with none of these set. PL-02 forbids a required cloud key, and a
# live demo that depends on a third-party API being reachable is a demo that can
# fail in the room, so `ollama` stays the default AND the reported configuration.
#
# They exist for one measured reason: no local 3B-7B model produced a unified
# diff that applies, 0 of 15 (ADR 0011). Diagnosis reached 10 of 10 on the same
# hardware; writing a diff is the part that needs a bigger model.
#
# Which provider answers. One of: ollama, openrouter, groq, gemini, opencodezen.
# Nothing infers this from which key happens to be set — a measurement whose
# model depends on the contents of a file nobody re-reads is not a measurement.
KAVACH_LLM_PROVIDER=ollama
#
# Set KAVACH_LLM_MODEL to a model that provider actually serves when you switch;
# the per-provider defaults are in apps/control-plane/kavach/llm/providers.py.
# Each provider is OpenAI-compatible, so one client serves all four.
#
# PLACEHOLDERS. Put real keys in .env, which is gitignored. Leave blank to keep
# a provider unavailable — blank is a supported state, not an error.
KAVACH_OPENROUTER_API_KEY=
KAVACH_GROQ_API_KEY=
KAVACH_GEMINI_API_KEY=
KAVACH_OPENCODEZEN_API_KEY=
# Ollama's hosted API (https://ollama.com/settings/keys). This is NOT the
# local server above - that one needs no key. Both can be configured at once;
# `ollama` and `ollamacloud` are separate providers and a run records which
# one answered.
KAVACH_OLLAMACLOUD_API_KEY=
# NVIDIA NIM / build.nvidia.com (https://build.nvidia.com/settings/api-keys).
# Keys look like nvapi-...
KAVACH_NVIDIA_API_KEY=
# TokenRouter (https://www.tokenrouter.com). Routes to upstream providers,
# so its model list is per-account: name the model with KAVACH_LLM_MODEL or
# the client refuses rather than guessing one.
KAVACH_TOKENROUTER_API_KEY=

KAVACH_LOG_LEVEL=INFO

# --- Target application -------------------------------------------------------
# Kavach points at the target by path; it is a separate repo and is NOT copied
# into this one. See targets/simple-rag.yaml.
#
# TWO PATHS TO THE SAME REPOSITORY, because the host and the image see it
# differently. KAVACH_TARGET_PATH is what a host run (`make dev-api`, the
# harnesses) opens. TARGET_REPO is what compose bind-mounts from, and it is
# relative to infra/, the compose file's own directory. Compose overrides
# KAVACH_TARGET_PATH to /app/target inside the container, so the value here is
# the host one and is not a contradiction.
KAVACH_TARGET_PATH=D:/Vit/Academics Sem-5/EDI/Target_RAG-App
TARGET_REPO=../../Target_RAG-App

# The token for the target's config interface (its manifest declares
# `auth_env: KAVACH_ADMIN_TOKEN`, and its compose reads the same name). Both
# sides are configured from the environment; neither holds a literal.
#
# PLACEHOLDER. Put the real value in .env, which is gitignored, and set the
# SAME value for the target's KAVACH_ADMIN_TOKEN or every config write is a 401.
KAVACH_TARGET_ADMIN_TOKEN=change-me

# Where Kavach reads its own files (fast_set.yaml, harness/baselines/). Unset on
# a host checkout, where it is derived. Compose sets it to /app for the
# container, which has no repository around the package.
# KAVACH_KAVACH_ROOT=
