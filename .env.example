# Kavach — copy to .env and adjust. NEVER commit .env (AGENTS.md rule 13).
# Every key here is declared in apps/control-plane/kavach/config.py.

# --- Control-plane host ports -------------------------------------------------
# Deliberately NOT 5432/6379/9090: the target application (Simple_RAG-Pipeline)
# publishes Postgres on 5432 and Prometheus on 9090. Colliding would make the
# two stacks unable to run side by side, which they must.
API_PORT=8000
POSTGRES_PORT=5433
REDIS_PORT=6380
PROMETHEUS_PORT=9091
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317

# --- Control-plane Postgres ---------------------------------------------------
POSTGRES_USER=kavach
POSTGRES_PASSWORD=kavach
POSTGRES_DB=kavach

# --- Kavach's own RCA model ---------------------------------------------------
# Points DIRECTLY at Ollama, never through Toxiproxy, so injecting F01/F02 into
# the target cannot blind the diagnostician (PRD.md §6.3).
#
# One Ollama only (ARCHITECTURE.md §2.4). From inside a container, the host
# instance is host.docker.internal; from the host it is localhost.
#
# Model note: ARCHITECTURE.md §2.4 documents qwen2.5:7b-instruct as the default
# and permits llama3.2 "to reuse an already-resident model when memory is
# tight". llama3.2 is set here because this demo machine has 8GB of VRAM and
# already has llama3.2 pulled, so qwen2.5:7b would both need a 4.7GB download
# and contend with the target's own models.
KAVACH_LLM_BASE_URL=http://host.docker.internal:11434
KAVACH_LLM_MODEL=llama3.2

KAVACH_LOG_LEVEL=INFO

# --- Target application -------------------------------------------------------
# Kavach points at the target by path; it is a separate repo and is NOT copied
# into this one. See targets/simple-rag.yaml.
KAVACH_TARGET_PATH=D:/Vit/Academics Sem-5/EDI/Target_RAG-App
