# Copy to .env and fill in. Never commit .env.

# --- Control plane ---------------------------------------------------------
# Kavach's postgres. Host port is 5433 (see infra/docker-compose.yml) because
# 5432 is commonly already taken by another project's database.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5433/kavach

# --- The application under management --------------------------------------
# Path to the onboarded application's kavach.yaml. Detection is disabled when
# unset, so the control plane never probes a target nobody asked it to watch.
TARGET_MANIFEST=../../targets/proof2/kavach.yaml
DETECTION_INTERVAL_S=15

# SIMULATION writes nothing. APPROVAL routes every action to a human.
# AUTONOMOUS executes LOW risk, sandboxes then approves MEDIUM, escalates HIGH.
EXECUTION_MODE=SIMULATION

# --- Local model -----------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Console ---------------------------------------------------------------
# Kavach's API. Port 8001, not 8000: 8000 is a common default and a second
# server on it silently answers the console instead of Kavach.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001
